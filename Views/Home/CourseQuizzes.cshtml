@model LanguageHub.Models.ViewModels.StudentCourseQuizzesViewModel
@{
    ViewData["Title"] = "Course Quizzes";
}

<div class="max-w-5xl mx-auto px-8 py-12 w-full">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
        <div>
            <h1 class="text-4xl font-display font-bold text-slate-900 mb-2">@Model.Course.Title</h1>
            <p class="text-slate-500 text-lg">Quizzes from @(Model.Course.Tutor?.Name ?? "your tutor").</p>
        </div>
        <a href="/Home/Dashboard" class="text-slate-500 hover:text-slate-800 font-bold transition-colors">&larr; Back to Dashboard</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-emerald-50 text-emerald-700 border border-emerald-200 p-4 rounded-xl mb-8 flex items-center shadow-sm">
            <i class="fa-solid fa-circle-check text-xl mr-3"></i>
            <span class="font-medium">@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (!Model.Course.Quizzes.Any())
    {
        <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center">
            <i class="fa-solid fa-clipboard-question text-4xl text-slate-300 mb-4"></i>
            <h2 class="text-xl font-bold text-slate-700 mb-2">No quizzes available yet</h2>
            <p class="text-slate-500">Your tutor has not published any quizzes for this course.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @foreach (var quiz in Model.Course.Quizzes)
            {
                var latestAttempt = Model.Attempts
                    .Where(a => a.QuizId == quiz.Id)
                    .OrderByDescending(a => a.SubmittedAt)
                    .FirstOrDefault();

                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                    <div class="flex items-start justify-between gap-4 mb-4">
                        <div>
                            <h2 class="text-xl font-display font-bold text-slate-900">@quiz.Title</h2>
                            <p class="text-sm text-slate-500 mt-1">@quiz.Questions.Count questions</p>
                        </div>
                        @if (latestAttempt != null)
                        {
                            <span class="bg-emerald-50 text-emerald-700 text-xs font-bold px-3 py-1 rounded-full">
                                @latestAttempt.Percentage.ToString("0.0")%
                            </span>
                        }
                    </div>

                    @if (latestAttempt != null)
                    {
                        <div class="bg-slate-50 border border-slate-100 rounded-xl p-3 mb-4">
                            <div class="text-sm text-slate-500">Latest grade</div>
                            <div class="text-lg font-bold text-slate-800">@latestAttempt.Score/@latestAttempt.TotalQuestions (@latestAttempt.Percentage.ToString("0.0")%)</div>
                            <div class="text-xs text-slate-400">@latestAttempt.SubmittedAt.ToString("MMM dd, yyyy hh:mm tt")</div>
                        </div>
                    }

                    <a href="/Home/TakeQuiz?quizId=@quiz.Id" class="block w-full text-center bg-brand-primary hover:bg-indigo-700 text-white font-bold py-3 rounded-xl transition-colors">
                        @(latestAttempt == null ? "Start Quiz" : "Retake Quiz")
                    </a>
                </div>
            }
        </div>
    }
</div>
