@{
    ViewData["Title"] = "Register";
}

<div class="max-w-5xl mx-auto px-8 py-12 w-full">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2">
            <div class="bg-slate-900 text-white p-10 flex flex-col justify-center">
                <span class="text-indigo-300 font-bold uppercase tracking-wider text-xs mb-4">Choose your workspace</span>
                <h1 class="text-4xl font-display font-bold mb-4">Create your LanguageHub account</h1>
                <p class="text-slate-300 leading-relaxed">
                    Students book courses and take quizzes. Tutors publish courses, create quizzes, and track student data and grades.
                </p>
            </div>

            <div class="p-10">
                <h2 class="text-2xl font-display font-bold text-slate-900 mb-6">Sign up</h2>

                @if (ViewBag.Error != null)
                {
                    <div class="bg-red-50 text-red-700 border border-red-200 p-4 rounded-xl mb-6">@ViewBag.Error</div>
                }

                <form asp-controller="Account" asp-action="Register" method="post" class="space-y-5">
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Full Name</label>
                        <input type="text" name="name" class="w-full border border-slate-200 rounded-xl p-3 focus:ring-2 focus:ring-brand-primary outline-none transition-all" required />
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Email address</label>
                        <input type="email" name="email" class="w-full border border-slate-200 rounded-xl p-3 focus:ring-2 focus:ring-brand-primary outline-none transition-all" required />
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Password</label>
                        <input type="password" name="password" class="w-full border border-slate-200 rounded-xl p-3 focus:ring-2 focus:ring-brand-primary outline-none transition-all" required />
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-3">Account type</label>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <label class="border border-slate-200 rounded-xl p-4 cursor-pointer hover:border-indigo-300 hover:bg-indigo-50 transition-colors">
                                <input type="radio" name="role" value="Student" class="mr-2" checked />
                                <span class="font-bold text-slate-800">Student</span>
                                <p class="text-sm text-slate-500 mt-1">Book courses, access quizzes, and view your grades.</p>
                            </label>
                            <label class="border border-slate-200 rounded-xl p-4 cursor-pointer hover:border-emerald-300 hover:bg-emerald-50 transition-colors">
                                <input type="radio" name="role" value="Tutor" class="mr-2" />
                                <span class="font-bold text-slate-800">Tutor</span>
                                <p class="text-sm text-slate-500 mt-1">Create courses, build quizzes, and track student results.</p>
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-brand-primary hover:bg-indigo-700 text-white font-bold py-3.5 rounded-xl shadow-lg transition-all">
                        Create Account
                    </button>
                </form>

                <div class="mt-5 text-center">
                    <a asp-controller="Account" asp-action="Login" class="text-brand-primary hover:text-indigo-700 font-bold text-sm">Already have an account? Login here.</a>
                </div>
            </div>
        </div>
    </div>
</div>
