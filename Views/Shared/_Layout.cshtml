<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LanguageHub</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: { brand: { primary: '#6366f1', secondary: '#10b981' } },
                    fontFamily: { sans: ['Inter', 'sans-serif'], display: ['Poppins', 'sans-serif'] }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 font-sans min-h-screen flex flex-col">
    <nav class="bg-white border-b border-slate-200 px-8 py-4 flex justify-between items-center shadow-sm sticky top-0 z-50 shrink-0">
        <div class="flex items-center space-x-10">
            <a href="/" class="text-2xl font-bold font-display tracking-tight text-slate-800">
                Language<span class="text-brand-primary">Hub</span>
            </a>
            <div class="hidden md:flex space-x-6 text-sm font-semibold text-slate-500">
                @if (Context.Session.GetString("IsTutor") != "True") {
                    <a href="/Home/BrowseCourses" class="hover:text-brand-primary transition-colors">Browse Courses</a>
                }
                @if (Context.Session.GetString("UserName") != null) {
                    <a href="/Home/Dashboard" class="hover:text-slate-800 transition-colors">My Dashboard</a>
                }
                @if (Context.Session.GetString("IsTutor") == "True") {
                    <a href="/Home/MyCourses" class="text-indigo-600 hover:text-indigo-700 transition-colors">My Courses</a>
                    <a href="/Home/CreateCourse" class="text-emerald-600 hover:text-emerald-700 transition-colors">+ Create Course</a>
                }
            </div>
        </div>
        <div class="flex items-center space-x-4">
            @if (Context.Session.GetString("UserName") != null) {
                <span class="text-sm font-medium text-slate-600">Hello, <span class="font-bold text-brand-primary">@Context.Session.GetString("UserName")!</span></span>
                <a href="/Account/Logout" class="border border-slate-300 hover:bg-slate-100 text-slate-600 text-xs font-bold py-2 px-4 rounded-lg transition-colors">Logout</a>
            } else {
                <a href="/Account/Login" class="text-slate-600 hover:text-slate-900 text-sm font-bold">Login</a>
                <a href="/Account/Register" class="bg-brand-primary hover:bg-indigo-700 text-white text-sm font-bold py-2 px-5 rounded-lg shadow-md shadow-indigo-500/20 transition-colors">Sign Up</a>
            }
        </div>
    </nav>

    <main role="main" class="flex-grow flex flex-col">
        @RenderBody()
    </main>
</body>
</html>
