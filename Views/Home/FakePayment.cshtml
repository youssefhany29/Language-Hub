@model LanguageHub.Models.Course
@{
    ViewData["Title"] = "Demo Payment";
}

<div class="max-w-6xl mx-auto px-8 py-12 w-full">
    <div class="mb-8">
        <a href="/Home/BrowseCourses" class="text-slate-500 hover:text-slate-800 font-bold transition-colors">&larr; Back to Courses</a>
        <h1 class="text-4xl font-display font-bold text-slate-900 mt-4 mb-2">Demo Checkout</h1>
        <p class="text-slate-500 text-lg">This is a university project payment screen. No real card is charged.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <div class="lg:col-span-7">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
                <div class="flex items-center justify-between mb-6 pb-5 border-b border-slate-100">
                    <div>
                        <h2 class="text-2xl font-display font-bold text-slate-900">Card Details</h2>
                        <p class="text-sm text-slate-500 mt-1">Use any fake numbers, for example 4242 4242 4242 4242.</p>
                    </div>
                    <span class="bg-amber-50 text-amber-700 border border-amber-200 text-xs font-bold px-3 py-1 rounded-full">TEST MODE</span>
                </div>

                @if (ViewBag.PaymentError != null)
                {
                    <div class="bg-red-50 text-red-700 border border-red-200 p-4 rounded-xl mb-6">
                        @ViewBag.PaymentError
                    </div>
                }

                <form action="/Home/ProcessFakePayment" method="post" class="space-y-5">
                    <input type="hidden" name="courseId" value="@Model.Id" />

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Cardholder Name</label>
                        <input type="text" name="cardHolder" required class="w-full border border-slate-200 rounded-xl p-3 focus:ring-2 focus:ring-brand-primary outline-none transition-all" placeholder="Student Name" />
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Card Number</label>
                        <div class="relative">
                            <i class="fa-regular fa-credit-card absolute left-4 top-4 text-slate-400"></i>
                            <input type="text" name="cardNumber" required minlength="12" maxlength="24" class="w-full border border-slate-200 rounded-xl p-3 pl-11 focus:ring-2 focus:ring-brand-primary outline-none transition-all" placeholder="4242 4242 4242 4242" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Expiry Date</label>
                            <input type="text" name="expiry" required class="w-full border border-slate-200 rounded-xl p-3 focus:ring-2 focus:ring-brand-primary outline-none transition-all" placeholder="12/30" />
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">CVV</label>
                            <input type="text" name="cvv" required maxlength="4" class="w-full border border-slate-200 rounded-xl p-3 focus:ring-2 focus:ring-brand-primary outline-none transition-all" placeholder="123" />
                        </div>
                    </div>

                    <div class="bg-slate-50 border border-slate-100 rounded-xl p-4 text-sm text-slate-500">
                        <i class="fa-solid fa-circle-info text-indigo-500 mr-2"></i>
                        This checkout only validates that demo fields are filled, then creates the booking.
                    </div>

                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-4 rounded-xl shadow-lg transition-colors">
                        Pay $@Model.Price.ToString("0.00") and Book Session
                    </button>
                </form>
            </div>
        </div>

        <div class="lg:col-span-5">
            <div class="bg-slate-900 text-white rounded-2xl p-8 shadow-xl sticky top-28">
                <span class="bg-indigo-500/20 text-indigo-200 text-xs uppercase font-bold px-3 py-1 rounded-full">@Model.TargetLanguage - @Model.TargetLevel</span>
                <h2 class="text-2xl font-display font-bold mt-5 mb-3">@Model.Title</h2>
                <p class="text-slate-300 text-sm leading-relaxed mb-6">@Model.Description</p>

                <div class="space-y-4 border-t border-slate-700 pt-6">
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-400">Tutor</span>
                        <span class="font-bold">@(Model.Tutor?.Name ?? "TBD")</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-400">Session Date</span>
                        <span class="font-bold">@DateTime.Now.AddDays(7).ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="flex justify-between items-center border-t border-slate-700 pt-4">
                        <span class="text-slate-300 font-bold">Total</span>
                        <span class="text-3xl font-display font-bold text-emerald-300">$@Model.Price.ToString("0.00")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
