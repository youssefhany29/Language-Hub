@model LanguageHub.Models.Course
@{
    ViewData["Title"] = "Create a Course";
}

<div class="max-w-3xl mx-auto px-8 py-12 w-full">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 p-10">
        <h1 class="text-4xl font-display font-bold text-slate-900 mb-2">Create a New Course</h1>
        <p class="text-slate-500 text-lg mb-8">Set up your class details and start earning.</p>

        <form action="/Home/CreateCourse" method="post" class="space-y-6">
            
            <div>
                <label class="block text-sm font-bold text-slate-700 mb-2">Course Title</label>
                <input type="text" name="Title" required class="w-full border border-slate-200 rounded-xl p-3 focus:ring-2 focus:ring-brand-primary outline-none transition-all" placeholder="e.g., Conversational Spanish" />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-2">Target Language</label>
                    <input type="text" name="TargetLanguage" required class="w-full border border-slate-200 rounded-xl p-3 focus:ring-2 focus:ring-brand-primary outline-none transition-all" placeholder="e.g., Spanish" />
                </div>
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-2">Target Level</label>
                    <select name="TargetLevel" required class="w-full border border-slate-200 rounded-xl p-3 focus:ring-2 focus:ring-brand-primary outline-none transition-all bg-white">
                        <option value="Beginner">Beginner (A1-A2)</option>
                        <option value="Intermediate">Intermediate (B1-B2)</option>
                        <option value="Advanced">Advanced (C1-C2)</option>
                    </select>
                </div>
            </div>

            <!-- NEW PRICE INPUT FIELD -->
            <div>
                <label class="block text-sm font-bold text-slate-700 mb-2">Price per Session (USD)</label>
                <div class="relative">
                    <span class="absolute left-4 top-3 text-slate-400 font-bold">$</span>
                    <input type="number" step="0.01" min="0" max="1000" name="Price" required class="w-full border border-slate-200 rounded-xl p-3 pl-8 focus:ring-2 focus:ring-brand-primary outline-none transition-all" placeholder="25.00" />
                </div>
            </div>

            <div>
                <label class="block text-sm font-bold text-slate-700 mb-2">Course Description</label>
                <textarea name="Description" required rows="4" class="w-full border border-slate-200 rounded-xl p-3 focus:ring-2 focus:ring-brand-primary outline-none transition-all" placeholder="Describe what students will learn..."></textarea>
            </div>

            <button type="submit" class="w-full bg-brand-primary hover:bg-indigo-700 text-white font-bold py-4 rounded-xl shadow-lg transition-all mt-4">
                Publish Course
            </button>
        </form>
    </div>
</div>