@model LanguageHub.Models.Course
@{
    ViewData["Title"] = "Review Course";
}

<div class="max-w-2xl mx-auto px-8 py-16">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 p-10">
        <h2 class="text-3xl font-display font-bold text-slate-800 mb-2">Rate Your Experience</h2>
        <p class="text-slate-400 mb-8">How was your session for <span class="font-bold text-brand-primary">@Model.Title</span>?</p>

        <form action="/Home/SubmitReview" method="post" class="space-y-6">
            <input type="hidden" name="courseId" value="@Model.Id" />

            <div>
                <label class="block text-sm font-bold text-slate-700 mb-3">Overall Rating</label>
                <div class="flex flex-row-reverse justify-end gap-2 text-3xl text-slate-300">
                    <input type="radio" name="rating" value="5" id="star5" class="peer hidden" required />
                    <label for="star5" class="cursor-pointer hover:text-amber-400 peer-checked:text-amber-400 transition-colors"><i class="fa-solid fa-star"></i></label>
                    
                    <input type="radio" name="rating" value="4" id="star4" class="peer hidden" />
                    <label for="star4" class="cursor-pointer hover:text-amber-400 peer-checked:text-amber-400 peer-checked:~label:text-amber-400 transition-colors"><i class="fa-solid fa-star"></i></label>
                    
                    <input type="radio" name="rating" value="3" id="star3" class="peer hidden" />
                    <label for="star3" class="cursor-pointer hover:text-amber-400 peer-checked:text-amber-400 transition-colors"><i class="fa-solid fa-star"></i></label>
                    
                    <input type="radio" name="rating" value="2" id="star2" class="peer hidden" />
                    <label for="star2" class="cursor-pointer hover:text-amber-400 peer-checked:text-amber-400 transition-colors"><i class="fa-solid fa-star"></i></label>
                    
                    <input type="radio" name="rating" value="1" id="star1" class="peer hidden" />
                    <label for="star1" class="cursor-pointer hover:text-amber-400 peer-checked:text-amber-400 transition-colors"><i class="fa-solid fa-star"></i></label>
                </div>
            </div>

            <div>
                <label class="block text-sm font-bold text-slate-700 mb-2">Written Review</label>
                <textarea name="comment" rows="4" class="w-full border border-slate-200 rounded-xl p-3 focus:ring-2 focus:ring-brand-primary outline-none transition-all text-sm" placeholder="What did you enjoy about the tutor?" required></textarea>
            </div>

            <button type="submit" class="w-full bg-brand-primary hover:bg-indigo-700 text-white font-bold py-4 rounded-xl shadow-lg transition-all mt-4">
                Submit Review
            </button>
        </form>
    </div>
</div>

<style>
    label:hover, label:hover ~ label, input:checked ~ label { color: #fbbf24 !important; }
</style>