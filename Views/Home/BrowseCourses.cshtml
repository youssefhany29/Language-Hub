@model IEnumerable<LanguageHub.Models.Course>
@{
    ViewData["Title"] = "Browse Courses";
    var currentUserId = Context.Session.GetInt32("UserId");
    var isTutor = Context.Session.GetString("IsTutor") == "True";
    var bookedCourseIds = ViewBag.BookedCourseIds as List<int> ?? new List<int>();
    var selectedLanguage = ViewBag.SelectedLanguage as string;
    var selectedLevel = ViewBag.SelectedLevel as string;
}

<div class="max-w-7xl mx-auto px-8 py-12 w-full">
    <div class="mb-10">
        <h1 class="text-4xl font-display font-bold text-slate-900 mb-3">Course Catalog</h1>
        <p class="text-slate-500 text-lg">Browse our available tutors and start speaking today.</p>
    </div>

    <form method="get" action="/Home/BrowseCourses" class="bg-white border border-slate-200 rounded-2xl p-5 mb-8 shadow-sm">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="md:col-span-2">
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Search</label>
                <input type="text" name="search" value="@ViewBag.Search" class="w-full border border-slate-200 rounded-xl p-3 focus:ring-2 focus:ring-brand-primary outline-none transition-all" placeholder="Course, language, or topic" />
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Language</label>
                <select name="language" class="w-full border border-slate-200 rounded-xl p-3 bg-white focus:ring-2 focus:ring-brand-primary outline-none transition-all">
                    <option value="">All languages</option>
                    @foreach (var language in (IEnumerable<string>)ViewBag.Languages)
                    {
                        if (selectedLanguage == language)
                        {
                            <option value="@language" selected>@language</option>
                        }
                        else
                        {
                            <option value="@language">@language</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Level</label>
                <select name="level" class="w-full border border-slate-200 rounded-xl p-3 bg-white focus:ring-2 focus:ring-brand-primary outline-none transition-all">
                    <option value="">All levels</option>
                    @foreach (var level in (IEnumerable<string>)ViewBag.Levels)
                    {
                        if (selectedLevel == level)
                        {
                            <option value="@level" selected>@level</option>
                        }
                        else
                        {
                            <option value="@level">@level</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 mt-4">
            <button type="submit" class="bg-slate-800 hover:bg-slate-900 text-white font-bold py-3 px-6 rounded-xl transition-colors">Apply Filters</button>
            <a href="/Home/BrowseCourses" class="text-center border border-slate-200 hover:bg-slate-50 text-slate-600 font-bold py-3 px-6 rounded-xl transition-colors">Clear</a>
        </div>
    </form>

    @if (TempData["SuccessMessage"] != null) {
        <div class="bg-emerald-50 text-emerald-700 border border-emerald-200 p-4 rounded-xl mb-8 flex items-center shadow-sm">
            <i class="fa-solid fa-circle-check text-xl mr-3"></i><span class="font-medium">@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        @if (!Model.Any()) {
            <div class="col-span-full text-center py-20 bg-white rounded-2xl border border-dashed border-slate-300">
                <i class="fa-regular fa-folder-open text-4xl text-slate-300 mb-4"></i>
                <p class="text-slate-500 text-lg font-medium">No courses available right now. Check back later!</p>
            </div>
        } else {
            @foreach (var course in Model) {
                var isBooked = bookedCourseIds.Contains(course.Id);
                <div class="bg-white rounded-2xl p-6 border border-slate-200 flex flex-col shadow-sm hover:shadow-md transition-shadow">
                    <span class="bg-indigo-600 text-white text-[10px] uppercase font-bold px-3 py-1.5 rounded-full w-fit mb-5">
                        @course.TargetLanguage - @course.TargetLevel
                    </span>
                    <h3 class="text-xl font-display font-bold text-slate-800 mb-2">@course.Title</h3>
                    
                    <div class="flex items-center mb-4">
                        @if (course.Reviews != null && course.Reviews.Any())
                        {
                            var avgRating = Math.Round(course.Reviews.Average(r => r.Rating), 1);
                            <div class="text-amber-400 text-sm mr-2">
                                <i class="fa-solid fa-star"></i>
                                <span class="font-bold text-slate-700 ml-1">@avgRating.ToString("0.0")</span>
                            </div>
                            <span class="text-xs text-slate-400">(@course.Reviews.Count reviews)</span>
                        }
                        else
                        {
                            <div class="text-slate-300 text-sm mr-2"><i class="fa-solid fa-star"></i></div>
                            <span class="text-xs text-slate-400">No reviews yet</span>
                        }
                    </div>

                    <p class="text-slate-600 text-sm mb-8 flex-grow leading-relaxed">@course.Description</p>
                    
                    <div class="flex items-center justify-between pt-4 border-t border-slate-100 mt-auto">
                        <span class="text-xs text-slate-400 font-medium">Instructor: <span class="font-bold text-slate-700">@(course.Tutor?.Name ?? "TBD")</span></span>
                        
                        @if (currentUserId == course.TutorId) {
                            <div class="flex gap-2 w-full ml-4">
                                <a href="/Home/ManageEducationalTools?courseId=@course.Id" class="bg-amber-100 text-amber-700 hover:bg-amber-200 text-center px-3 py-2 rounded-lg text-xs font-bold transition-all w-1/2 flex items-center justify-center">
                                    <i class="fa-solid fa-layer-group mr-1"></i> Tools
                                </a>
                                <form asp-controller="Home" asp-action="DeleteCourse" method="post" class="w-1/2" onsubmit="return confirm('Delete completely?');">
                                    <input type="hidden" name="id" value="@course.Id" />
                                    <button type="submit" class="w-full bg-red-50 text-red-600 hover:bg-red-500 hover:text-white border border-red-200 px-3 py-2 rounded-lg text-xs font-bold transition-all">Delete</button>
                                </form>
                            </div>
                        } else {
                            <form asp-controller="Home" asp-action="BookSession" method="post" class="flex items-center gap-3">
                                <!-- NEW PRICE DISPLAY -->
                                <span class="font-bold text-emerald-600 text-lg">$@course.Price.ToString("0.00")</span>
                                <input type="hidden" name="courseId" value="@course.Id" />
                                <button type="submit" disabled="@isBooked" class="@(isBooked ? "bg-slate-200 text-slate-500 cursor-not-allowed" : "bg-indigo-600 hover:bg-indigo-700 text-white shadow-md") px-5 py-2 rounded-lg text-xs font-bold whitespace-nowrap">
                                    @(isBooked ? "Booked" : "Book Session")
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <div class="mt-16 bg-gradient-to-r from-indigo-600 to-indigo-800 rounded-2xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between text-white shadow-xl shadow-indigo-900/10">
        <div class="mb-6 md:mb-0 text-center md:text-left">
            <h4 class="text-3xl font-display font-bold mb-2">Want to teach?</h4>
            <p class="text-indigo-100 text-lg opacity-90">Join our network of professional tutors today.</p>
        </div>
        <a href="@(isTutor ? "/Home/CreateCourse" : "/Account/Register")" class="bg-white text-indigo-700 hover:bg-slate-50 font-bold py-3.5 px-8 rounded-xl shadow-lg transition-colors whitespace-nowrap">
            @(isTutor ? "+ Create a New Course" : "Become a Tutor")
        </a>
    </div>
</div>
