@model LanguageHub.Models.Course
@{
    ViewData["Title"] = "Manage Quizzes";
}

<div class="max-w-6xl mx-auto px-8 py-12 w-full">
    
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-4xl font-display font-bold text-slate-900 mb-2">Course Quizzes</h1>
            <p class="text-slate-500 text-lg">Managing assessments for: <span class="font-bold text-brand-primary">@Model.Title</span></p>
        </div>
        <a href="/Home/MyCourses" class="text-slate-500 hover:text-slate-800 font-bold transition-colors">&larr; Back to My Courses</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-emerald-50 text-emerald-700 border border-emerald-200 p-4 rounded-xl mb-8 flex items-center shadow-sm">
            <i class="fa-solid fa-circle-check text-xl mr-3"></i>
            <span class="font-medium">@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <!-- LEFT SIDE: CREATE FORMS -->
        <div class="lg:col-span-5 space-y-8">
            
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <h2 class="text-xl font-display font-bold text-slate-800 mb-4 border-b border-slate-100 pb-2">1. Create a New Quiz</h2>
                <form action="/Home/CreateQuiz" method="post" class="space-y-4">
                    <input type="hidden" name="courseId" value="@Model.Id" />
                    <div>
                        <input type="text" name="quizTitle" required class="w-full border border-slate-200 rounded-xl p-3 focus:ring-2 focus:ring-brand-primary outline-none transition-all text-sm" placeholder="e.g., Module 1: Greetings" />
                    </div>
                    <button type="submit" class="w-full bg-slate-800 hover:bg-slate-900 text-white font-bold py-3 rounded-xl transition-all shadow-md text-sm">
                        Create Quiz
                    </button>
                </form>
            </div>

            @if (Model.Quizzes.Any())
            {
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 border-t-4 border-t-brand-primary">
                    <h2 class="text-xl font-display font-bold text-slate-800 mb-4 border-b border-slate-100 pb-2">2. Add a Question</h2>
                    <form action="/Home/AddQuestion" method="post" class="space-y-4">
                        <input type="hidden" name="courseId" value="@Model.Id" />
                        
                        <div>
                            <label class="block text-xs font-bold text-slate-500 mb-1 uppercase tracking-wide">Select Quiz</label>
                            <select name="quizId" required class="w-full border border-slate-200 rounded-xl p-3 outline-none text-sm font-bold text-slate-700 bg-slate-50">
                                @foreach (var quiz in Model.Quizzes) { <option value="@quiz.Id">@quiz.Title</option> }
                            </select>
                        </div>
                        
                        <div>
                            <label class="block text-xs font-bold text-slate-500 mb-1 uppercase tracking-wide">Question Text</label>
                            <textarea name="questionText" required rows="2" class="w-full border border-slate-200 rounded-xl p-3 focus:ring-2 focus:ring-brand-primary outline-none transition-all text-sm" placeholder="e.g., How do you say 'Hello'?"></textarea>
                        </div>

                        <div class="space-y-2">
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide">Multiple Choice Options</label>
                            <div class="flex items-center gap-2">
                                <input type="radio" name="correctOption" value="1" required class="w-4 h-4 text-brand-primary" title="Mark as correct answer">
                                <input type="text" name="option1" required class="w-full border border-slate-200 rounded-lg p-2 text-sm" placeholder="Option 1" />
                            </div>
                            <div class="flex items-center gap-2">
                                <input type="radio" name="correctOption" value="2" class="w-4 h-4 text-brand-primary" title="Mark as correct answer">
                                <input type="text" name="option2" required class="w-full border border-slate-200 rounded-lg p-2 text-sm" placeholder="Option 2" />
                            </div>
                            <div class="flex items-center gap-2">
                                <input type="radio" name="correctOption" value="3" class="w-4 h-4 text-brand-primary" title="Mark as correct answer">
                                <input type="text" name="option3" required class="w-full border border-slate-200 rounded-lg p-2 text-sm" placeholder="Option 3" />
                            </div>
                        </div>

                        <button type="submit" class="w-full bg-brand-primary hover:bg-indigo-700 text-white font-bold py-3 rounded-xl transition-all shadow-md text-sm mt-2">
                            Add Question
                        </button>
                    </form>
                </div>
            }
        </div>

        <!-- RIGHT SIDE: LIVE PREVIEW OF QUIZZES -->
        <div class="lg:col-span-7">
            <h2 class="text-2xl font-display font-bold text-slate-800 mb-6">Live Quizzes</h2>
            
            @if (!Model.Quizzes.Any())
            {
                <div class="bg-slate-50 p-10 rounded-2xl border border-dashed border-slate-300 text-center">
                    <i class="fa-solid fa-clipboard-question text-4xl text-slate-300 mb-3"></i>
                    <p class="text-slate-500 font-medium">No quizzes created yet.<br>Create one using the form on the left!</p>
                </div>
            }
            else
            {
                <div class="space-y-6">
                    @foreach (var quiz in Model.Quizzes)
                    {
                        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                            
                            <div class="flex justify-between items-center mb-4 border-b border-slate-100 pb-3">
                                <div class="flex items-center">
                                    <h3 class="text-lg font-bold text-slate-800">
                                        <i class="fa-solid fa-clipboard-check text-emerald-500 mr-2"></i>@quiz.Title
                                    </h3>
                                    <span class="text-xs font-bold text-slate-500 bg-slate-100 px-3 py-1 rounded-full ml-3">
                                        @quiz.Questions.Count Questions
                                    </span>
                                </div>
                                
                                <form action="/Home/DeleteQuiz" method="post" onsubmit="return confirm('Are you sure you want to delete this entire quiz?');">
                                    <input type="hidden" name="quizId" value="@quiz.Id" />
                                    <input type="hidden" name="courseId" value="@Model.Id" />
                                    <button type="submit" class="text-slate-300 hover:text-red-500 transition-colors" title="Delete Quiz">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </form>
                            </div>
                            
                            @if (!quiz.Questions.Any())
                            {
                                <p class="text-sm text-slate-400 italic">This quiz is empty. Add a question to it!</p>
                            }
                            else
                            {
                                <div class="space-y-4">
                                    @foreach (var question in quiz.Questions)
                                    {
                                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 group relative">
                                            
                                            <div class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity">
                                                <form action="/Home/DeleteQuestion" method="post" onsubmit="return confirm('Delete this question?');">
                                                    <input type="hidden" name="questionId" value="@question.Id" />
                                                    <input type="hidden" name="courseId" value="@Model.Id" />
                                                    <button type="submit" class="text-slate-400 hover:text-red-500 transition-colors" title="Delete Question">
                                                        <i class="fa-solid fa-xmark text-lg"></i>
                                                    </button>
                                                </form>
                                            </div>

                                            <p class="font-bold text-slate-700 text-sm mb-3 pr-6">Q: @question.Text</p>
                                            <div class="grid grid-cols-1 gap-2 pl-4 border-l-2 border-slate-200">
                                                @foreach (var option in question.AnswerOptions)
                                                {
                                                    <div class="text-sm @(option.IsCorrect ? "text-emerald-600 font-bold" : "text-slate-500")">
                                                        <i class="fa-solid @(option.IsCorrect ? "fa-check-circle" : "fa-circle") text-xs mr-2 opacity-70"></i>
                                                        @option.Text
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
