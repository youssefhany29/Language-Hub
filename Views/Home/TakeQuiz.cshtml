@model LanguageHub.Models.Quiz
@{
    ViewData["Title"] = "Take Quiz";
}

<div class="max-w-4xl mx-auto px-8 py-12 w-full">
    <div class="mb-8">
        <a href="/Home/CourseQuizzes?courseId=@Model.CourseId" class="text-slate-500 hover:text-slate-800 font-bold transition-colors">&larr; Back to Quizzes</a>
        <h1 class="text-4xl font-display font-bold text-slate-900 mt-4 mb-2">@Model.Title</h1>
        <p class="text-slate-500 text-lg">@Model.Course?.Title</p>
    </div>

    @if (!Model.Questions.Any())
    {
        <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center">
            <i class="fa-solid fa-clipboard-question text-4xl text-slate-300 mb-4"></i>
            <h2 class="text-xl font-bold text-slate-700 mb-2">This quiz has no questions yet</h2>
            <p class="text-slate-500">Please check again after your tutor adds questions.</p>
        </div>
    }
    else
    {
        <form action="/Home/SubmitQuiz" method="post" class="space-y-6">
            <input type="hidden" name="quizId" value="@Model.Id" />

            @{
                var questionNumber = 1;
            }
            @foreach (var question in Model.Questions)
            {
                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                    <h2 class="text-lg font-bold text-slate-900 mb-4">Question @questionNumber: @question.Text</h2>
                    <div class="space-y-3">
                        @foreach (var option in question.AnswerOptions)
                        {
                            <label class="flex items-center gap-3 bg-slate-50 hover:bg-indigo-50 border border-slate-100 rounded-xl p-3 cursor-pointer transition-colors">
                                <input type="radio" name="answers[@question.Id]" value="@option.Id" required class="w-4 h-4 text-brand-primary" />
                                <span class="text-slate-700 font-medium">@option.Text</span>
                            </label>
                        }
                    </div>
                </div>
                questionNumber++;
            }

            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-4 rounded-xl shadow-lg transition-colors">
                Submit Quiz
            </button>
        </form>
    }
</div>
