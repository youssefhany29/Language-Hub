@model IEnumerable<LanguageHub.Models.Booking>
@{
    ViewData["Title"] = "My Dashboard";
    var isTutor = Context.Session.GetString("IsTutor") == "True";
}

<div class="max-w-6xl mx-auto px-8 py-12 w-full">
    
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-4xl font-display font-bold text-slate-900 mb-2">@(isTutor ? "Tutor Dashboard" : "Student Dashboard")</h1>
            <p class="text-slate-500 text-lg">Manage your upcoming language sessions.</p>
        </div>
        @if (isTutor)
        {
            <div class="flex gap-3">
                <a href="/Home/MyCourses" class="bg-slate-800 hover:bg-slate-900 text-white font-bold py-2.5 px-6 rounded-xl shadow-md transition-colors whitespace-nowrap">
                    My Courses
                </a>
                <a href="/Home/CreateCourse" class="bg-brand-primary hover:bg-indigo-700 text-white font-bold py-2.5 px-6 rounded-xl shadow-md transition-colors whitespace-nowrap">
                    + New Course
                </a>
            </div>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-emerald-50 text-emerald-700 border border-emerald-200 p-4 rounded-xl mb-8 flex items-center shadow-sm">
            <i class="fa-solid fa-circle-check text-xl mr-3"></i>
            <span class="font-medium">@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        @if (isTutor)
        {
            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Courses</div>
                <div class="text-3xl font-display font-bold text-slate-900">@ViewBag.TotalCourses</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Students</div>
                <div class="text-3xl font-display font-bold text-indigo-600">@ViewBag.TotalStudents</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Quiz Submissions</div>
                <div class="text-3xl font-display font-bold text-emerald-600">@ViewBag.TotalSubmissions</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Avg Grade</div>
                <div class="text-3xl font-display font-bold text-amber-500">@ViewBag.AverageGrade%</div>
            </div>
        }
        else
        {
            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Booked Courses</div>
                <div class="text-3xl font-display font-bold text-slate-900">@ViewBag.TotalBookings</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Completed Quizzes</div>
                <div class="text-3xl font-display font-bold text-emerald-600">@ViewBag.CompletedQuizzes</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Avg Grade</div>
                <div class="text-3xl font-display font-bold text-amber-500">@ViewBag.AverageGrade%</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Next Session</div>
                <div class="text-lg font-display font-bold text-indigo-600">
                    @(ViewBag.NextSession == null ? "Not booked" : ((DateTime)ViewBag.NextSession).ToString("MMM dd"))
                </div>
            </div>
        }
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        @if (!Model.Any())
        {
            <div class="p-12 text-center">
                <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4 border border-slate-100">
                    <i class="fa-regular fa-calendar-xmark text-3xl text-slate-300"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-700 mb-2">No upcoming sessions</h3>
                <p class="text-slate-500 mb-6">@(isTutor ? "You don't have any students booked yet." : "You haven't booked any courses yet.")</p>
                @if (!isTutor)
                {
                    <a href="/Home/BrowseCourses" class="bg-slate-800 hover:bg-slate-900 text-white font-bold py-3 px-6 rounded-xl transition-colors">Browse Tutors</a>
                }
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 text-sm uppercase tracking-wider">
                            <th class="px-6 py-4 font-bold rounded-tl-2xl">Date & Time</th>
                            <th class="px-6 py-4 font-bold">Course</th>
                            <th class="px-6 py-4 font-bold">@(isTutor ? "Student" : "Tutor")</th>
                            <th class="px-6 py-4 font-bold text-center rounded-tr-2xl">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var booking in Model)
                        {
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="font-bold text-slate-800">@booking.SessionDate.ToString("MMM dd, yyyy")</div>
                                    <div class="text-sm text-slate-500">@booking.SessionDate.ToString("hh:mm tt")</div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="font-bold text-brand-primary">@booking.Course?.Title</div>
                                    <div class="text-xs text-slate-400 uppercase tracking-wider font-bold mt-0.5">@booking.Course?.TargetLanguage</div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center">
                                        <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-xs mr-3">
                                            @(isTutor ? booking.Student?.Name?.Substring(0, 1) : booking.Course?.Tutor?.Name?.Substring(0, 1))
                                        </div>
                                        <span class="font-medium text-slate-700">@(isTutor ? booking.Student?.Name : booking.Course?.Tutor?.Name)</span>
                                    </div>
                                </td>
                                
                                @if (isTutor)
                                {
                                    <td class="px-6 py-4 text-center">
                                        <form action="/Home/CancelBooking" method="post" onsubmit="return confirm('Are you sure you want to cancel this session?');">
                                            <input type="hidden" name="id" value="@booking.Id" />
                                            <button type="submit" class="text-red-400 hover:text-red-600 font-bold text-sm transition-colors py-1 px-3 rounded-lg hover:bg-red-50">
                                                Cancel
                                            </button>
                                        </form>
                                    </td>
                                }
                                else
                                {
                                    <td class="px-6 py-4 text-center">
                                        <div class="flex items-center justify-center space-x-3">
                                            <a href="/Home/CourseQuizzes?courseId=@booking.CourseId" class="text-emerald-600 hover:text-emerald-700 text-sm font-bold transition-colors py-1 px-3 rounded-lg hover:bg-emerald-50">
                                                <i class="fa-solid fa-clipboard-question mr-1"></i>Quizzes
                                            </a>
                                            <a href="/Home/ReviewCourse?courseId=@booking.CourseId" class="text-brand-primary hover:text-indigo-700 text-sm font-bold transition-colors py-1 px-3 rounded-lg hover:bg-indigo-50">
                                                <i class="fa-solid fa-star mr-1"></i>Review
                                            </a>
                                            <form action="/Home/CancelBooking" method="post" onsubmit="return confirm('Are you sure you want to cancel this session?');">
                                                <input type="hidden" name="id" value="@booking.Id" />
                                                <button type="submit" class="text-red-400 hover:text-red-600 font-bold text-sm transition-colors py-1 px-3 rounded-lg hover:bg-red-50">
                                                    Cancel
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
